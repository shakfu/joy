[1 2 3] [2 <] all false =.
[1 2 3] [4 <] all.
"test" ['t <] all false =.
"test" ['u <] all.
{1 2 3} [2 <] all false =.
{1 2 3} [4 <] all.

[] [2 <] all.
"" ['t <] all.
{} [2 <] all.

(* An empty test leaves each member as its own truth value *)
[1 2 3] [] all.
"test"  [] all.
{1 2 3} [] all.
[1 0 3] [] all false =.
